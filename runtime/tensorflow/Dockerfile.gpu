# Built-in runtime TensorFlow, GPU image: ghcr.io/brf-tech/runr/exec-tensorflow:<VERSION>-gpu,
# TensorFlow with its and-cuda extra (requirements-cuda.txt): the CUDA 12 libraries come as
# NVIDIA's pip wheels, the driver from the node, which must support CUDA 12.
#
#   runtime/ci.sh ml-runtimes tensorflow gpu
#   docker build --platform linux/amd64 --build-context runtime-python=runtime/python \
#     -f runtime/tensorflow/Dockerfile.gpu -t ghcr.io/brf-tech/runr/exec-tensorflow:2.21-gpu runtime/tensorflow
FROM ghcr.io/brf-tech/runr/reqs/python:3.12-slim
ARG VERSION=2.21

WORKDIR /app

# As in the CPU image (Dockerfile); the build checks that TensorFlow is a CUDA 12 build (a GPU is
# not needed for that).
RUN --mount=type=bind,source=requirements-cuda.txt,target=/tmp/requirements-cuda.txt \
    --mount=type=bind,source=requirements.txt,target=/tmp/requirements.txt \
    pip install --no-cache-dir --no-compile --upgrade pip==26.2.1 setuptools==84.0.0 && \
    pip install --no-cache-dir --no-compile -r /tmp/requirements-cuda.txt -r /tmp/requirements.txt && \
    python -m compileall -q -j 0 --invalidation-mode unchecked-hash \
      "$(python -c 'import sysconfig; print(sysconfig.get_path("stdlib"))')" && \
    pip check && \
    TF_CPP_MIN_LOG_LEVEL=2 python -B -c "import sys, tensorflow as tf, keras, numpy, scipy, pandas, matplotlib, sklearn; \
v = tf.__version__; cuda = tf.sysconfig.get_build_info().get('cuda_version', ''); print('tensorflow', v, 'cuda', cuda); \
sys.exit(0 if v.startswith('${VERSION}.') and tf.test.is_built_with_cuda() and cuda.startswith('12.') else 'tensorflow ' + v + ' is not a CUDA 12 build of ${VERSION}')"

COPY --from=runtime-python server.py runner.py entrypoint.sh ./
RUN chmod +x entrypoint.sh

RUN mkdir -p /app/code

ENV RUNR_MODE=http
ENV RUNR_HANDLER=handler
ENV RUNR_FILENAME=main.py
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

EXPOSE 8080

ENTRYPOINT ["./entrypoint.sh"]
