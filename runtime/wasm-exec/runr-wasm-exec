#!/bin/sh
# runr-wasm-exec build — the build step of the wasm-exec runtime (docs/wasm.md#wasm-exec): turns the
# project in the current directory into main.wasm, a WASI command — a preview 1 module or, for Go, a
# WASI 0.2 component — for Spin's WAGI executor. RunR then pushes the Spin app (spin.toml +
# main.wasm) with `spin registry push`.
#
# Where the module comes from, first match wins:
#   RUNR_WASM_MODULE   an uploaded module (wasm.upload, or an upload: runtime version), fetched from
#                      the region registry over plain HTTP — nothing is compiled
#   build.sh           the project's own build; it must write main.wasm
#   build.zig          zig build (-Dtarget=wasm32-wasi, ReleaseSmall); the first .wasm it installs
#   *.zig              zig build-exe of main.zig (or the only .zig file)
#   go.mod / *.go      TinyGo (-target=wasip2): a component. Spin runs a preview 1 module through the
#                      WASI adapter, which takes pages of the module's memory for its own state, and
#                      TinyGo's heap grows over them — a Go module crashed or corrupted its objects
#                      once it allocated past its initial memory. A component needs no adapter.
#   *.cc / *.cpp       wasi-sdk clang++ (all C and C++ files)
#   *.c                wasi-sdk clang (all C files)
set -eu

cmd="${1:-build}"
if [ "$cmd" != "build" ]; then
  echo "usage: runr-wasm-exec build" >&2
  exit 2
fi

out="main.wasm"
has() { ls $1 >/dev/null 2>&1; }

if [ -n "${RUNR_WASM_MODULE:-}" ]; then
  echo "runr: uploaded module ${RUNR_WASM_MODULE}"
  runr-image-upload fetch "${RUNR_WASM_MODULE}" "$out"
elif [ -f build.sh ]; then
  echo "runr: build.sh"
  sh ./build.sh
elif [ -f build.zig ]; then
  echo "runr: zig build ($(zig version))"
  zig build -Dtarget=wasm32-wasi -Doptimize=ReleaseSmall --prefix /tmp/zig-out
  cp "$(find /tmp/zig-out -name '*.wasm' | head -n 1)" "$out"
elif has '*.zig'; then
  src="main.zig"
  [ -f "$src" ] || src="$(ls *.zig | head -n 1)"
  echo "runr: zig build-exe ${src} ($(zig version))"
  zig build-exe -target wasm32-wasi -O ReleaseSmall -femit-bin="$out" "$src"
elif [ -f go.mod ] || has '*.go'; then
  [ -f go.mod ] || printf 'module runr-function\n\ngo 1.22\n' > go.mod
  echo "runr: tinygo build ($(tinygo version))"
  tinygo build -target=wasip2 -no-debug -o "$out" .
elif has '*.cc' || has '*.cpp' || has '*.cxx'; then
  echo "runr: wasi-sdk clang++"
  # shellcheck disable=SC2046
  "${WASI_SDK_PATH}/bin/clang++" --target=wasm32-wasip1 -O2 -fno-exceptions -o "$out" $(ls *.c *.cc *.cpp *.cxx 2>/dev/null)
elif has '*.c'; then
  echo "runr: wasi-sdk clang"
  "${WASI_SDK_PATH}/bin/clang" --target=wasm32-wasip1 -O2 -o "$out" *.c
else
  echo "runr: nothing to build — add C, C++, Zig or Go sources, a build.sh, or a wasm.upload naming an uploaded module" >&2
  exit 1
fi

if [ ! -s "$out" ]; then
  echo "runr: the build did not write ${out}" >&2
  exit 1
fi
magic="$(head -c 4 "$out" | od -An -tx1 | tr -d ' \n')"
if [ "$magic" != "0061736d" ]; then
  echo "runr: ${out} is not a WebAssembly binary" >&2
  exit 1
fi
echo "runr: ${out} ($(wc -c < "$out") bytes)"
