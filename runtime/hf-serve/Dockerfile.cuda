# RunR hf-serve, GPU image: the CPU image's pipelines on CUDA PyTorch, plus diffusers for
# text-to-image. Model services on the "transformers" engine with a GPU and on the "diffusers"
# engine run it.
# torch 2.14.1 built for CUDA 12.6 (the same torch as the CPU image): CUDA 12.x runs on the R550
# drivers of the GPU Operator RunR installs (minor version compatibility); CUDA 13 builds need R580+.
# From the reqs mirror of docker.io/pytorch/pytorch (runtime/lib/mirror.sh).
FROM ghcr.io/brf-tech/runr/reqs/pytorch:2.14.1-cuda12.6-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    HF_HOME=/models/hf \
    HF_HUB_DISABLE_TELEMETRY=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    RUNR_DEVICE=cuda \
    PORT=8080

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg libsndfile1 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/hf-serve

# spin, a developer CLI of the base image that nothing here uses, requires a click below the one
# hf-serve's server needs (pip check fails with it)
RUN pip uninstall -y spin

# torch comes with the base image; the same pins as the CPU image for everything else. The base's
# Python is the system Python (PEP 668 marks it externally managed, PIP_BREAK_SYSTEM_PACKAGES above):
# this image is its only user. pip and setuptools are installed next to the distribution's copies.
# The build fails unless pip check passes.
COPY requirements.txt requirements-cuda.txt ./
RUN pip install --ignore-installed pip==26.2.1 setuptools==84.0.0 \
 && pip install -r requirements.txt -r requirements-cuda.txt \
 && pip check

COPY runr_hf_serve ./runr_hf_serve
RUN python -m compileall -q runr_hf_serve

RUN useradd --uid 10001 --user-group --create-home --home-dir /home/runr runr \
 && mkdir -p /models/hf \
 && chown -R 10001:10001 /models
USER 10001

EXPOSE 8080
ENTRYPOINT ["python", "-m", "runr_hf_serve"]
CMD ["serve"]
