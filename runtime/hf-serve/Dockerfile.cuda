# RunR hf-serve, GPU image: the CPU image's pipelines on CUDA PyTorch, plus diffusers for
# text-to-image. Model services on the "transformers" engine with a GPU and on the "diffusers"
# engine run it.
FROM docker.io/pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/models/hf \
    HF_HUB_DISABLE_TELEMETRY=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    RUNR_DEVICE=cuda \
    PORT=8080

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg libsndfile1 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/hf-serve

# torch comes with the base image; the same pins as the CPU image for everything else
COPY requirements.txt requirements-cuda.txt ./
RUN pip install -r requirements.txt -r requirements-cuda.txt

COPY runr_hf_serve ./runr_hf_serve
RUN python -m compileall -q runr_hf_serve

RUN useradd --uid 10001 --user-group --create-home --home-dir /home/runr runr \
 && mkdir -p /models/hf \
 && chown -R 10001:10001 /models
USER 10001

EXPOSE 8080
ENTRYPOINT ["python", "-m", "runr_hf_serve"]
CMD ["serve"]
