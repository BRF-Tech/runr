# Built-in runtime PyTorch, GPU image: ghcr.io/brf-tech/runr/exec-pytorch:<VERSION>-gpu, the CPU
# image's contents with torch and torchvision built for CUDA 12.6 (PyTorch's cu126 wheel index;
# the CUDA libraries come as NVIDIA's pip wheels, the driver from the node, which must support
# CUDA 12). The same torch build as hf-serve's CUDA image.
#
#   runtime/ci.sh ml-runtimes pytorch gpu
#   docker build --platform linux/amd64 --build-context runtime-python=runtime/python \
#     -f runtime/pytorch/Dockerfile.gpu -t ghcr.io/brf-tech/runr/exec-pytorch:2.14-gpu runtime/pytorch
FROM ghcr.io/brf-tech/runr/reqs/python:3.12-slim
ARG VERSION=2.14

WORKDIR /app

# As in the CPU image (Dockerfile), with the cu126 index; the build checks that torch is a CUDA
# 12.6 build (a GPU is not needed for that).
RUN --mount=type=bind,source=requirements-torch.txt,target=/tmp/requirements-torch.txt \
    --mount=type=bind,source=requirements.txt,target=/tmp/requirements.txt \
    pip install --no-cache-dir --no-compile --upgrade pip==26.2.1 setuptools==84.0.0 && \
    pip install --no-cache-dir --no-compile \
      --index-url https://download.pytorch.org/whl/cu126 -r /tmp/requirements-torch.txt && \
    pip install --no-cache-dir --no-compile -r /tmp/requirements.txt && \
    python -m compileall -q -j 0 --invalidation-mode unchecked-hash \
      "$(python -c 'import sysconfig; print(sysconfig.get_path("stdlib"))')" && \
    pip check && \
    python -B -c "import sys, torch, torchvision, numpy, scipy, pandas, matplotlib, sklearn; \
v = torch.__version__; print('torch', v, 'cuda', torch.version.cuda); \
sys.exit(0 if v.startswith('${VERSION}.') and torch.version.cuda == '12.6' else 'torch ' + v + ' is not a CUDA 12.6 build of ${VERSION}')"

COPY --from=runtime-python server.py runner.py entrypoint.sh ./
RUN chmod +x entrypoint.sh

RUN mkdir -p /app/code

ENV RUNR_MODE=http
ENV RUNR_HANDLER=handler
ENV RUNR_FILENAME=main.py
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

EXPOSE 8080

ENTRYPOINT ["./entrypoint.sh"]
