ARG VERSION=2.3
FROM nvidia/cuda:12.3.2-runtime-ubuntu22.04
# An ARG declared before FROM is not visible inside the stage without this line
ARG VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv && \
    ln -s /usr/bin/python3 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# pip >= 23 needs it for the system Python; pip 22 (Ubuntu 22.04) ignores the variable but
# rejects the --break-system-packages flag
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# PyTorch GPU (CUDA 12.x) + ML essentials. The Ubuntu stdlib already carries .pyc (compiled by
# dpkg); site-packages bytecode is compiled once in the same layer (pip --no-compile): level 0 =
# entrypoint.sh (python -u, no -O), unchecked-hash = used without looking at source mtimes.
RUN pip install --no-cache-dir --no-compile \
    torch==${VERSION}.0 torchvision torchaudio \
    numpy scipy pandas matplotlib scikit-learn && \
    python -m compileall -q -j 0 --invalidation-mode unchecked-hash \
      $(python -c 'import site; print(" ".join(site.getsitepackages()))')

COPY server.py runner.py entrypoint.sh ./
RUN chmod +x entrypoint.sh

RUN mkdir -p /app/code

ENV RUNR_MODE=http
ENV RUNR_HANDLER=handler
ENV RUNR_FILENAME=main.py
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

EXPOSE 8080

ENTRYPOINT ["./entrypoint.sh"]
