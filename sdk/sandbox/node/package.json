{
  "name": "@runr/sandbox",
  "version": "0.1.0",
  "description": "TypeScript client for the RunR Sandbox API: isolated code execution for AI agents and apps on your own Kubernetes cluster.",
  "license": "MIT",
  "author": "RunR contributors",
  "homepage": "https://runr.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runrsh/core.git",
    "directory": "sdk/sandbox/node"
  },
  "keywords": [
    "runr",
    "sandbox",
    "code-interpreter",
    "ai-agents",
    "kubernetes",
    "gvisor",
    "kata-containers"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/polyfill.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  }
}
