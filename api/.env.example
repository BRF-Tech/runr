APP_NAME="RunR"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://runrapi.test

LOG_CHANNEL=stack
LOG_STACK=single

DB_CONNECTION=sqlite

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=8063

MAIL_MAILER=log

SANCTUM_STATEFUL_DOMAINS=localhost:8061,localhost:5173

KNATIVE_MIN_K8S_MINOR=30

BUILD_SERVER_URL=https://host.docker.internal/api
BUILD_CALLBACK_HOST=runrapi.test
BUILD_INSECURE_TLS=1

# API rate limiting (HTTP 429) — config/ratelimit.php
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=1200
API_USER_RATE_LIMIT_PER_MINUTE=300
API_GUEST_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# SAML 2.0 SP endpoints (entity ID, ACS, metadata) are built from this base URL; defaults to APP_URL
# SAML_SP_BASE_URL=
