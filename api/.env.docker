APP_NAME="RunR"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost

# Local/e2e only — set explicitly here so it's visible instead of an app-level fallback.
ADMIN_PASSWORD=admin123

LOG_CHANNEL=stack
LOG_STACK=single,stderr

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=runr
DB_USERNAME=runr
DB_PASSWORD=runr

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PREFIX=

REVERB_APP_ID=runr-local
REVERB_APP_KEY=runr-local-key
REVERB_APP_SECRET=runr-local-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=runr-reverb
REVERB_PORT=8080
REVERB_SCHEME=http

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@runr.sh
MAIL_FROM_NAME="${APP_NAME}"

KNATIVE_MIN_K8S_MINOR=30

BUILD_SERVER_URL=http://api/api
BUILD_CALLBACK_HOST=
BUILD_INSECURE_TLS=0

FRONTEND_URL=http://localhost:8061

