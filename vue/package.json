{
  "name": "runr-ui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=stack",
    "test:e2e:mock": "playwright test --project=mock --project=mock-modules",
    "test:e2e:create-flows": "playwright test --project=stack create-flows",
    "shots": "playwright test --config shots/playwright.config.ts"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@lucide/vue": "^1.72.0",
    "@sentry/vue": "^11.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.7",
    "cronstrue": "3.30.0",
    "dompurify": "^3.4.17",
    "driver.js": "^1.4.0",
    "flag-icons": "^7.5.0",
    "laravel-echo": "^2.3.1",
    "monaco-editor": "^0.57.0",
    "pdfmake": "^0.3.6",
    "pinia": "^4.1.0",
    "pusher-js": "^8.4.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "$dompurify"
  }
}
