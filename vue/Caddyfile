# Port: RUNR_UI_PORT (the Helm chart sets it from ui.port), 80 when unset
:{$RUNR_UI_PORT:80} {
    root * /srv
    # Only responses without a pre-compressed file (below): small files and the branding defaults.
    # gzip first: on the fly zstd was the slowest for large files
    encode gzip zstd

    # Hashed build assets: cached for a year. Not the platform's branding defaults, which the
    # container writes at start (docker-entrypoint.sh) and a new configuration changes
    @assets {
        path *.js *.css *.woff *.woff2 *.svg *.png *.jpg *.ico *.webp *.ttf *.eot
        not path /branding-defaults.js
    }
    header @assets Cache-Control "public, max-age=31536000, immutable"

    @index {
        path /index.html /branding-defaults.js
    }
    header @index Cache-Control "no-store, no-cache, must-revalidate"

    try_files {path} /index.html
    # The build's .br / .gz next to each text file (Dockerfile), in the client's preference, Brotli
    # first when it takes both
    file_server {
        precompressed br gzip
    }
}
