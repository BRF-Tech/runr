# Port: RUNR_UI_PORT (the Helm chart sets it from ui.port), 80 when unset
:{$RUNR_UI_PORT:80} {
    root * /srv
    # Only responses without a pre-compressed file (below): small files and the branding defaults.
    # gzip first: on the fly zstd was the slowest for large files
    encode gzip zstd

    # In this order: the route block keeps it. Caddy's own directive order sets headers before
    # try_files rewrites the path, so a console route (/, /login, /projects/…) got index.html
    # without its Cache-Control. The checks: ci/check-caddyfiles.sh
    route {
        # A build file that is not there, e.g. a chunk of the previous build that a console opened
        # before an upgrade asks for: 404 (the console loads again, src/utils/staleChunks.js),
        # never index.html under the build files' immutable header
        @missingBuildFile {
            path /assets/*
            not file
        }
        header @missingBuildFile Cache-Control "no-store"
        respond @missingBuildFile 404

        try_files {path} /index.html

        # Decided on the path try_files left. index.html (every console route) and the platform's
        # branding defaults, which the container writes at start (docker-entrypoint.sh) and a new
        # configuration changes: never cached
        @noStore path /index.html /branding-defaults.js
        header @noStore Cache-Control "no-store, no-cache, must-revalidate"
        # The hashed build files (Vite: /assets/<name>-<hash>.<ext>): cached for a year
        header /assets/* Cache-Control "public, max-age=31536000, immutable"

        # The build's .br / .gz next to each text file (Dockerfile), in the client's preference,
        # Brotli first when it takes both
        file_server {
            precompressed br gzip
        }
    }
}
