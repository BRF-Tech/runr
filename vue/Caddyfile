# Port: RUNR_UI_PORT (the Helm chart sets it from ui.port), 80 when unset
:{$RUNR_UI_PORT:80} {
    root * /srv
    encode zstd gzip

    @assets {
        path *.js *.css *.woff *.woff2 *.svg *.png *.jpg *.ico *.webp *.ttf *.eot
    }
    header @assets Cache-Control "public, max-age=31536000, immutable"

    @index {
        path /index.html
    }
    header @index Cache-Control "no-store, no-cache, must-revalidate"

    try_files {path} /index.html
    file_server
}
