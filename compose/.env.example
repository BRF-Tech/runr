# ── Gateway ───────────────────────────────────────────────────────────────────
# Port the gateway publishes on the host. Behind the HTTPS proxy on the host (README section 7):
# 127.0.0.1:8080, the loopback interface only.
PORT=80

# ── Modules ───────────────────────────────────────────────────────────────────
# Read by build.sh for the UI build and by docker-compose.yml for the API containers: set them
# before building the images, and build again after changing them.
TENANCY_ENABLED=false
AUTH_PROVIDER_ENABLED=false
TICKET_ENABLED=true
# Billing (docs/billing.md): bills per project and month for an external invoicing system
BILLING_ENABLED=false

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=runr
DB_USER=runr
DB_PASS=CHANGE_ME_STRONG_PASSWORD
