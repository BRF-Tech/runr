# ── RunR function domain through this host (a kind region) ───────────────────
# *.fn.example.com → the Traefik load balancer of a kind cluster on this host (compose/kind-setup.sh),
# which only this host reaches. Appended to Caddyfile-host (compose/README.md, section 7):
#   cat Caddyfile-host Caddyfile-wildcard | sudo tee /etc/caddy/Caddyfile >/dev/null
#   sudo systemctl reload caddy
#
# In RunR, the region's function domain is fn.example.com — <region name>.<base domain>, here the
# region "fn" with the base domain example.com (Settings → Platform → Base Domain): projects are
# served at https://<project>.fn.example.com.
#
# Certificate: a wildcard certificate for *.fn.example.com. Let's Encrypt issues wildcard
# certificates only through the DNS challenge, which needs a Caddy built with the module of your DNS
# provider (https://caddyserver.com/docs/automatic-https#dns-challenge); with it, replace the tls
# line below with `tls { dns <provider> <credentials> }`.
#
# Upstream: the IP address the region page lists under DNS Configuration, or
#   kubectl --context kind-runr -n knative-serving get service traefik \
#     -o jsonpath='{.status.loadBalancer.ingress[0].ip}'
# Update it when the address changes (for example after the kind cluster was recreated).

*.fn.example.com {
    tls /etc/ssl/private/fn.example.com/fullchain.pem /etc/ssl/private/fn.example.com/privkey.pem

    reverse_proxy 172.19.0.5:80 {
        # Streaming functions (SSE of hosted MCP servers, docs/mcp.md) are not buffered
        flush_interval -1
        transport http {
            read_timeout  300s
            write_timeout 300s
        }
    }
}
