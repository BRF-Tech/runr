{
    # A proxy in front of the gateway (the TLS proxy on the host, README section 7) connects from a
    # private address: its X-Forwarded-For and X-Forwarded-Proto are kept and the gateway appends
    # the proxy's address; for any other client the gateway sets them itself. The API takes the
    # request scheme from X-Forwarded-Proto and the client address from X-Forwarded-For
    # (TRUSTED_PROXY_HOPS in api.env).
    servers {
        trusted_proxies static private_ranges
    }
}

:80 {
    # MCP responses may be SSE streams: never compressed (encode would buffer them)
    @compressible not path /mcp /mcp/* /oauth2/* /.well-known/oauth-*
    encode @compressible zstd gzip

    # WebSocket → reverb (the /ws prefix is stripped)
    handle /ws/* {
        uri strip_prefix /ws
        reverse_proxy reverb:8080
    }

    # AI agents (docs/mcp.md): RunR MCP server, hosted MCP servers (/mcp/servers/*), the OAuth
    # authorization server and its metadata — streamed through (SSE)
    @mcp path /mcp /mcp/* /oauth2/* /.well-known/oauth-*
    handle @mcp {
        reverse_proxy api:80 {
            header_up X-Forwarded-Host {host}
            header_up X-Real-IP {remote_host}
            flush_interval -1
        }
    }

    # API
    handle /api/* {
        reverse_proxy api:80 {
            header_up X-Forwarded-Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # SSO sign-in callback of an OAuth / OIDC provider (web route of the API:
    # /oauth/{provider}/callback). The console's own /oauth/callback page stays with the SPA.
    handle /oauth/*/callback {
        reverse_proxy api:80 {
            header_up X-Forwarded-Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Project git remotes (smart HTTP, served by the API; responses streamed)
    handle /git/* {
        reverse_proxy api:80 {
            header_up X-Forwarded-Host {host}
            header_up X-Real-IP {remote_host}
            flush_interval -1
        }
    }

    # Horizon dashboard — the installation's administrators only, signed in with a single-use link
    # (php artisan runr:horizon-link, POST /api/horizon/link; README → Horizon dashboard)
    @horizon path /horizon /horizon/*
    handle @horizon {
        reverse_proxy api:80 {
            header_up X-Forwarded-Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Storage (Laravel public disk)
    handle /storage/* {
        reverse_proxy api:80
    }

    # SPA static files (catch-all), as the ui image's own Caddyfile serves them (vue/Caddyfile):
    # in this order, which the route block keeps (Caddy's own order sets headers before try_files
    # rewrites the path). The checks: ci/check-caddyfiles.sh
    handle {
        root * /srv
        route {
            # A build file that is not there (a chunk of the previous build): 404, not index.html
            @missingBuildFile {
                path /assets/*
                not file
            }
            header @missingBuildFile Cache-Control "no-store"
            respond @missingBuildFile 404

            try_files {path} /index.html

            # index.html (every console route) and the branding defaults the ui image writes at
            # start: never cached; the hashed build files: cached for a year
            @noStore path /index.html /branding-defaults.js
            header @noStore Cache-Control "no-store, no-cache, must-revalidate"
            header /assets/* Cache-Control "public, max-age=31536000, immutable"

            file_server
        }
    }
}
