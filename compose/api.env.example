APP_NAME="RunR"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single,stderr

# ── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=runr
DB_USERNAME=runr
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Cache / Queue ────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PREFIX=

# ── Reverb (WebSocket) ──────────────────────────────────────────────────────
REVERB_APP_ID=runr-prod
REVERB_APP_KEY=CHANGE_ME_REVERB_KEY
REVERB_APP_SECRET=CHANGE_ME_REVERB_SECRET
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_FROM_ADDRESS=noreply@runr.local
MAIL_FROM_NAME="${APP_NAME}"

# ── Knative ──────────────────────────────────────────────────────────────────
KNATIVE_MIN_K8S_MINOR=30

# ── Build Server ─────────────────────────────────────────────────────────────
BUILD_SERVER_URL=http://api/api
BUILD_CALLBACK_HOST=
BUILD_INSECURE_TLS=0

# ── Frontend URL (OAuth callback, invitation links) ─────────────────────────
FRONTEND_URL=http://localhost

# ── Sanctum ──────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost
